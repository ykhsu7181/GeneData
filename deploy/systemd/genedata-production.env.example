# Copy to /home/labuser/rdcheng/gd/config/genedata-production.env.
# Do not commit the populated production file.

DJANGO_SETTINGS_MODULE=filemanager.settings_production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

GENEDATA_DB_HOST=127.0.0.1
GENEDATA_DB_PORT=3307
GENEDATA_DB_NAME=gene_manage
GENEDATA_DB_USER=gene_user
GENEDATA_DB_PASSWORD=replace-with-the-database-password

GENEDATA_MANUAL_FILES_DIR=/home/labuser/rdcheng/gd/manual_files
GENEDATA_DERIVED_DATA_DIR=/home/labuser/rdcheng/gd/derived_data
GENEDATA_EXTERNAL_ARCHIVE_ROOT=/home/labuser/rdcheng/gd/external_archives
GENEDATA_EXTERNAL_ARCHIVE_INTERNAL_URI=/_protected_external_archives/
GENEDATA_BGZIP_COMMAND=bgzip
GENEDATA_TABIX_COMMAND=tabix

GENEDATA_ALLOW_ANONYMOUS_PUBLIC_CONTENT=true
GENEDATA_ANON_CONTENT_RATE=5/minute
GENEDATA_ANON_CONTENT_DAILY_RATE=20/day
GENEDATA_TOKEN_CONTENT_RATE=30/minute

# Leave HTTPS redirect and HSTS disabled until the reverse-proxy ownership and
# all relevant hostnames have been verified.
GENEDATA_SECURE_SSL_REDIRECT=false
GENEDATA_SECURE_HSTS_SECONDS=0
GENEDATA_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
GENEDATA_SECURE_HSTS_PRELOAD=false
GENEDATA_TRUST_X_FORWARDED_PROTO=true
