# Required production secrets. Supply real values through the service environment.
DJANGO_SECRET_KEY=
GENEDATA_DB_PASSWORD=

# Optional production database overrides.
GENEDATA_DB_NAME=gene_manage
GENEDATA_DB_USER=gene_user
GENEDATA_DB_HOST=127.0.0.1
GENEDATA_DB_PORT=3307

# JBrowse derived artifacts and external index tools.
GENEDATA_DERIVED_DATA_DIR=/home/labuser/rdcheng/gd/derived_data
GENEDATA_JBROWSE_DATA_DIR=/home/labuser/rdcheng/gd/derived_data/jbrowse
GENEDATA_BGZIP_COMMAND=bgzip
GENEDATA_TABIX_COMMAND=tabix
GENEDATA_JBROWSE_MANUAL_INTERNAL_PREFIX=/_protected_manual_files/
GENEDATA_JBROWSE_DERIVED_INTERNAL_PREFIX=/_protected_derived_data/

# Optional comma-separated Accession values shown on the portal homepage.
GENEDATA_FEATURED_ACCESSIONS=
