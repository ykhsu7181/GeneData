{
  "registry_version": "2",
  "profiles": [
    {
      "data_type_key": "sequence",
      "profile_key": "reference_genome",
      "schema_version": "2.0.0",
      "deprecated": false,
      "replacement": null,
      "file_role_rules": {
        "genome_fasta": {"class": "core", "min": 1, "max": 1},
        "fasta_index": {"class": "auxiliary", "min": 0, "max": 1},
        "compression_index": {"class": "auxiliary", "min": 0, "max": 1},
        "metadata": {"class": "auxiliary", "min": 0, "max": null}
      },
      "context_rules": {
        "assembly": {"min": 1, "max": 1}
      },
      "metadata_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "assembly_method": {"type": "string", "minLength": 1},
          "sequencing_platforms": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "coverage": {"type": "number", "minimum": 0},
          "external_identifiers": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    {
      "data_type_key": "image",
      "profile_key": "microscopy_image_set",
      "schema_version": "2.0.0",
      "deprecated": false,
      "replacement": null,
      "file_role_rules": {
        "primary_image": {"class": "core", "min": 1, "max": null},
        "thumbnail": {"class": "auxiliary", "min": 0, "max": null},
        "acquisition_metadata": {"class": "auxiliary", "min": 0, "max": 1}
      },
      "context_rules": {
        "sample": {"min": 0, "max": null}
      },
      "metadata_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "instrument": {"type": "string", "minLength": 1},
          "modality": {"type": "string", "minLength": 1},
          "pixel_size": {
            "type": "object",
            "properties": {
              "value": {"type": "number", "exclusiveMinimum": 0},
              "unit": {"type": "string", "enum": ["nm", "um", "mm"]}
            },
            "required": ["value", "unit"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "data_type_key": "table",
      "profile_key": "research_table",
      "schema_version": "2.0.0",
      "deprecated": false,
      "replacement": null,
      "file_role_rules": {
        "primary_table": {"class": "core", "min": 1, "max": null},
        "data_dictionary": {"class": "auxiliary", "min": 0, "max": 1},
        "metadata": {"class": "auxiliary", "min": 0, "max": null}
      },
      "context_rules": {
        "sample": {"min": 0, "max": null},
        "assembly": {"min": 0, "max": null},
        "annotation": {"min": 0, "max": null}
      },
      "metadata_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "delimiter": {"type": "string", "enum": ["tab", "comma", "semicolon"]},
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "data_type": {
                  "type": "string",
                  "enum": ["string", "integer", "number", "boolean", "date", "datetime"]
                },
                "unit": {"type": "string", "minLength": 1}
              },
              "required": ["name", "data_type"],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
